filters:
  and:
    - file.inFolder("Characters")
views:
  - type: table
    name: BaseView
    order:
      - file.name
      - Ch_Name
      - CharacterID
      - Ch_MaxHealth
      - Ch_Closeness_Start
      - Ch_Conviction_Selfsufficient_Start
      - Ch_Conviction_Settler_Start
      - Ch_Conviction_Signaler_Start
      - Ch_Dialogues
  - type: table
    name: DialogueDataView
    order:
      - file.name
      - Ch_Name
      - Ch_Dialogues
