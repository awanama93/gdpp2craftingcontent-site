filters:
  and:
    - file.inFolder("QuestNarrative/Response")
views:
  - type: table
    name: BasicView
    order:
      - file.name
      - ResponseID
      - R_DialogueParent
      - R_ResponseCodename
      - R_Prerequisite
      - R_PrerequisiteValue
      - R_Text
      - R_Outcome
      - R_NextDialogue
      - R_ResponseRelation
      - R_Type
    columnSize:
      note.ResponseID: 148
      note.R_Type: 99
      note.R_Text: 172
      note.R_Outcome: 122
  - type: table
    name: CodenameTextView
    order:
      - file.name
      - R_DialogueParent
      - R_ResponseCodename
      - R_Text
    columnSize:
      note.R_DialogueParent: 192
      note.R_Text: 172
  - type: table
    name: DialoguePrerequisiteView
    order:
      - file.name
      - R_DialogueParent
      - R_ResponseCodename
      - R_Prerequisite
      - R_PrerequisiteValue
  - type: table
    name: OutcomeNextDialogueView
    order:
      - file.name
      - R_DialogueParent
      - R_ResponseCodename
      - R_Outcome
      - R_NextDialogue
    columnSize:
      file.name: 121
      note.R_DialogueParent: 125
      note.R_ResponseCodename: 190
  - type: table
    name: PrerequisiteOnlyView
    order:
      - file.name
      - R_ResponseCodename
      - R_Prerequisite
      - R_PrerequisiteValue
  - type: table
    name: ResponseTypeNRelationView
    order:
      - file.name
      - R_ResponseCodename
      - R_ResponseType
      - R_ResponseRelation
  - type: table
    name: AllQuestRelationView
    order:
      - file.name
      - R_Type
      - R_ResponseCodename
      - R_QuestRelation
      - R_Text
      - R_Prerequisite
      - R_PrerequisiteValue
    columnSize:
      file.name: 121
      note.R_Type: 99
      note.R_ResponseCodename: 172
      note.R_Text: 172
