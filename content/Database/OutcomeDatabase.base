filters:
  and:
    - file.inFolder("QuestNarrative/Outcome")
views:
  - type: table
    name: BasicView
    order:
      - file.name
      - OutcomeID
      - O_ResponseRelation
      - O_QuestDataA
      - O_QuestStatusA
      - O_QuestDataB
      - O_QuestStatusB
      - O_QuestDataC
      - O_QuestStatusC
      - O_QuestDataD
      - O_QuestStatusD
      - O_QuestDataE
      - O_QuestStatusE
    columnSize:
      note.OutcomeID: 127
