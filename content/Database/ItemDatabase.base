filters:
  and:
    - file.inFolder("Item")
views:
  - type: table
    name: BasicView
    order:
      - file.name
      - ItemID
      - ItemType
      - I_BreakPoint
      - I_StackSize
      - I_Description
      - I_SpawnedItem
      - I_ProcessingStage
      - I_EffectA
      - I_EffectA_Value
      - I_EffectB
      - I_EffectB_Value
      - I_EffectC
      - I_EffectC_Value
      - I_LootableA
      - I_LootableA_DropChance
      - I_LootableA_Quantity
      - I_LootableB
      - I_LootableB_DropChance
      - I_LootableB_Quantity
      - I_LootableC
      - I_LootableC_DropChance
      - I_LootableC_Quantity
      - I_LootableD
      - I_LootableD_DropChance
      - I_LootableD_Quantity
      - Cr_IngredientA
      - Cr_IngredientAQuantity
      - Cr_IngredientB
      - Cr_IngredientBQuantity
      - Cr_IngredientC
      - Cr_IngredientCQuantity
      - Cr_IngredientD
      - Cr_IngredientDQuantity
      - Cr_IngredientE
      - Cr_IngredientEQuantity
      - I_LootableE
      - I_LootableE_DropChance
      - I_LootableE_Quantity
      - I_LootableF
      - I_LootableF_DropChance
      - I_LootableF_Quantity
      - I_LootableG
      - I_LootableG_DropChance
      - I_LootableG_Quantity
      - I_LootableH
      - I_LootableH_DropChance
      - I_LootableH_Quantity
      - CraftingMethod
      - I_IsIngredientOf
  - type: table
    name: LootableView
    filters:
      or:
        - ItemType.contains("InventoryCraftable")
        - ItemType.contains("Consumable")
    order:
      - file.name
      - ItemID
      - ItemType
      - I_BreakPoint
      - I_ProcessingStage
      - I_SpawnedItem
      - I_LootableA
      - I_LootableA_DropChance
      - I_LootableA_Quantity
      - I_LootableB
      - I_LootableB_DropChance
      - I_LootableB_Quantity
      - I_LootableC
      - I_LootableC_DropChance
      - I_LootableC_Quantity
      - I_LootableD
      - I_LootableD_DropChance
      - I_LootableD_Quantity
      - I_LootableE
      - I_LootableE_DropChance
      - I_LootableE_Quantity
      - I_LootableF
      - I_LootableF_DropChance
      - I_LootableF_Quantity
      - I_LootableG
      - I_LootableG_DropChance
      - I_LootableG_Quantity
      - I_LootableH
      - I_LootableH_DropChance
      - I_LootableH_Quantity
    columnSize:
      note.I_LootableE: 177
      note.I_LootableF: 169
      note.I_LootableG: 139
      note.I_LootableH: 164
  - type: table
    name: CraftingView
    order:
      - file.name
      - ItemID
      - ItemType
      - CraftingMethod
      - I_ProcessingStage
      - Cr_IngredientA
      - Cr_IngredientAQuantity
      - Cr_IngredientB
      - Cr_IngredientBQuantity
      - Cr_IngredientC
      - Cr_IngredientCQuantity
      - Cr_IngredientD
      - Cr_IngredientDQuantity
      - Cr_IngredientE
      - Cr_IngredientEQuantity
    columnSize:
      file.name: 128
      note.ItemID: 56
      note.CraftingMethod: 204
    rowHeight: medium
  - type: table
    name: ConsumableView
    order:
      - file.name
      - ItemID
      - ItemType
      - I_EffectA
      - I_EffectA_Value
      - I_EffectB
      - I_EffectB_Value
      - I_EffectC
      - I_EffectC_Value
  - type: table
    name: ProcessingStageView
    order:
      - file.name
      - ItemType
      - I_ProcessingStage
      - CraftingMethod
  - type: table
    name: LootableOnlyItemView
    filters:
      and:
        - file.name.startsWith("LO_")
    order:
      - file.name
      - I_LootableA
      - I_LootableB
      - I_LootableC
      - I_LootableD
      - I_LootableE
      - I_LootableF
      - I_LootableG
      - I_LootableH
  - type: table
    name: IngredientsView
    filters:
      and:
        - I_ProcessingStage.contains("Level 1")
    order:
      - file.name
      - I_IsIngredientOf
      - I_ProcessingStage
    columnSize:
      file.name: 154
      note.I_IsIngredientOf: 214
